# Скопируйте этот файл в .env и заполните значениями.
# НИКОГДА не коммитьте .env в git (он уже в .gitignore).

# API-ключ для LLM-провайдера
OPENAI_API_KEY=sk-вставь-сюда-ключ

# Base URL провайдера. ВНИМАНИЕ: сторонний прокси видит все ваши запросы.
# По возможности используйте официальный endpoint провайдера.
OPENAI_BASE_URL=https://api.aikeysforyou.com/v1
